{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "mcp__serenasitter__activate_project",
      "mcp__serenasitter__analyze_code",
      "mcp__serenasitter__batch",
      "mcp__serenasitter__batch_edit",
      "mcp__serenasitter__check_shell_command_batch",
      "mcp__serenasitter__clear_cache",
      "mcp__serenasitter__edit_symbol",
      "mcp__serenasitter__execute_shell_command_batch",
      "mcp__serenasitter__expand",
      "mcp__serenasitter__fetch_context",
      "mcp__serenasitter__find_files",
      "mcp__serenasitter__find_symbol",
      "mcp__serenasitter__get_config",
      "mcp__serenasitter__get_context",
      "mcp__serenasitter__get_diagnostics",
      "mcp__serenasitter__help",
      "mcp__serenasitter__index_status",
      "mcp__serenasitter__investigate",
      "mcp__serenasitter__list_languages",
      "mcp__serenasitter__project_snapshot",
      "mcp__serenasitter__read_file",
      "mcp__serenasitter__refactor_check",
      "mcp__serenasitter__reindex_project",
      "mcp__serenasitter__search_code",
      "mcp__serenasitter__search_index",
      "mcp__serenasitter__semantic_doc_search",
      "mcp__serenasitter__symbol_navigate",
      "mcp__serenasitter__write_file",
      "Bash(graft:*)",
      "Bash(npx graft:*)",
      "Bash(graft-dev:*)",
      "Bash(node dist/cli.js:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/lakshya/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/lakshya/.claude/helpers/graft-hooks.cjs\" session-start",
            "timeout": 8000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/lakshya/.claude/helpers/graft-hooks.cjs\" post-edit",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__graft__|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/lakshya/.claude/helpers/graft-hooks.cjs\" tool-savings",
            "timeout": 8000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/lakshya/.claude/helpers/graft-hooks.cjs\" prompt",
            "timeout": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/lakshya/.claude/helpers/graft-hooks.cjs\" stop",
            "timeout": 8000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); if [ -n \"$used\" ]; then printf \"%s | ctx: %.0f%% used\" \"$model\" \"$used\"; else printf \"%s\" \"$model\"; fi"
  },
  "footerLinksRegexes": [],
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/graft-statusline.cjs\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "postman@claude-plugins-official": true,
    "mongodb@claude-plugins-official": true,
    "desktop-commander@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "swift-lsp@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true,
    "document-skills@anthropic-agent-skills": true,
    "claude-mem-cowork@thedotmack": true,
    "mattpocock-skills@claude-plugins-official": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "theme": "dark-ansi",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "effortLevel": "medium"
}
